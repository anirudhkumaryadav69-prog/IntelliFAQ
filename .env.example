# IntelliFAQ 2.0 — Environment Configuration Example
# Copy to .env (never commit .env with real credentials) or configure in Render / Vercel.

# ---------------------------------------------------------------------------
# Database Selection
# ---------------------------------------------------------------------------
# Production: PostgreSQL Shared Session Pooler URL from Supabase (IPv4-compatible, port 5432)
# Leave unset locally to use SQLite
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Local SQLite database path (defaults to backend/instance/intellifaq.db)
INTELLIFAQ_DB_PATH=backend/instance/intellifaq.db

# ---------------------------------------------------------------------------
# Document Storage
# ---------------------------------------------------------------------------
# Production: Supabase private Storage bucket (server-side only)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_STORAGE_BUCKET=intellifaq-documents

# Local development upload directory (defaults to backend/instance/uploads)
INTELLIFAQ_UPLOAD_DIR=backend/instance/uploads

# Maximum document upload size in bytes (default: 10 MB)
INTELLIFAQ_MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Admin Bootstrap & Security
# ---------------------------------------------------------------------------
# Production admin bootstrap (required on first PostgreSQL startup; never hardcode)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional alternative variable names supported for local bootstrap
INTELLIFAQ_ADMIN_USERNAME=admin
INTELLIFAQ_ADMIN_PASSWORD=replace-with-strong-password

# Set to 1 in production (HTTPS) so admin session cookies include Secure & SameSite=None
INTELLIFAQ_COOKIE_SECURE=0

# Comma-separated additional frontend origins allowed by CORS (e.g., Vercel URL)
CORS_ORIGINS=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Frontend (Vercel)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000
