# IntelliFAQ 2.0 — Environment Configuration Example
# Copy to .env (never commit .env with real credentials) or export in your shell.

# Backend SQLite database path (defaults to backend/instance/intellifaq.db)
INTELLIFAQ_DB_PATH=backend/instance/intellifaq.db

# Backend document upload storage directory (defaults to backend/instance/uploads)
INTELLIFAQ_UPLOAD_DIR=backend/instance/uploads

# Maximum document upload size in bytes (default: 10 MB)
INTELLIFAQ_MAX_UPLOAD_BYTES=10485760

# Initial administrator bootstrap credentials (change before running)
INTELLIFAQ_ADMIN_USERNAME=admin
INTELLIFAQ_ADMIN_PASSWORD=replace-with-strong-password

# Set to 1 when serving over HTTPS so admin session cookies include the Secure flag
INTELLIFAQ_COOKIE_SECURE=0

# Frontend API base URL (optional; defaults to http://<current-host>:5000)
VITE_API_BASE_URL=http://localhost:5000
